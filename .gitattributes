# Chuẩn hoá line ending sang LF cho mọi text file
# Khắc phục noise CRLF do OneDrive sync trên Windows
* text=auto eol=lf

# Đánh dấu binary để git không cố gắng merge
*.html  binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.pdf   binary
*.docx  binary
*.pptx  binary
*.xlsx  binary
*.geojson binary
*.h5    binary
*.pkl   binary
*.model binary

# File Python / shell: bắt buộc LF
*.py    text eol=lf
*.sh    text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.txt   text eol=lf
